@model GestionViajes.Models.Reserva

@{
    ViewData["Title"] = "Editar reserva";
}

<h1>Editar reserva</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ReservaId" />
            <div class="form-group mb-2">
                <label asp-for="DestinoId" class="control-label"></label>
                <select asp-for="DestinoId" class="form-control" asp-items="ViewBag.Destinos"></select>
                <span asp-validation-for="DestinoId" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="TuristaId" class="control-label"></label>
                <select asp-for="TuristaId" class="form-control" asp-items="ViewBag.Turistas"></select>
                <span asp-validation-for="TuristaId" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="FechaReserva" class="control-label"></label>
                <input asp-for="FechaReserva" class="form-control" type="date" />
                <span asp-validation-for="FechaReserva" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="FechaViaje" class="control-label"></label>
                <input asp-for="FechaViaje" class="form-control" type="date" />
                <span asp-validation-for="FechaViaje" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Personas" class="control-label"></label>
                <input asp-for="Personas" class="form-control" type="number" />
                <span asp-validation-for="Personas" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Total" class="control-label"></label>
                <input asp-for="Total" class="form-control" type="number" step="0.01" readonly />
                <span asp-validation-for="Total" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Estado" class="control-label"></label>
                <input asp-for="Estado" class="form-control" />
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}