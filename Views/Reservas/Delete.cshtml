@model GestionViajes.Models.Reserva

@{
    ViewData["Title"] = "Eliminar reserva";
}

<h1>Eliminar reserva</h1>
<h3>¿Está seguro de eliminar esta reserva?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Destino</dt>
        <dd class="col-sm-9">@Model.Destino?.Nombre</dd>
        <dt class="col-sm-3">Turista</dt>
        <dd class="col-sm-9">@Model.Turista?.Nombre @Model.Turista?.Apellido</dd>
        <dt class="col-sm-3">Fecha viaje</dt>
        <dd class="col-sm-9">@Model.FechaViaje.ToShortDateString()</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="ReservaId" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>